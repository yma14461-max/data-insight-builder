# ==============================================================================
#  AI Data Insight Builder — 환경변수 설정 가이드 (readme.env)
# ==============================================================================
# 
# [사용 방법]
# 1. 로컬 환경에서 사용 시:
#    이 파일의 내용을 복사하여 같은 위치에 '.env' 파일을 생성하고,
#    본인의 Google Gemini API 키를 입력하세요.
#
# 2. Vercel 배포 시:
#    Vercel 프로젝트 대시보드 -> Settings -> Environment Variables 메뉴에서
#    아래 Key / Value 값들을 추가하세요.
#
# ==============================================================================

# 1. Google Gemini API 키 (필수)
# Google AI Studio (https://aistudio.google.com/)에서 무료로 발급받은 API 키를 입력합니다.
GEMINI_API_KEY=your_gemini_api_key_here

# 2. 사용할 Gemini 모델 (선택사항, 기본값: gemini-3.5-flash-lite)
# 추천 모델: gemini-3.5-flash-lite (속도가 가장 빠르고 안정적)
GEMINI_MODEL=gemini-3.5-flash-lite

# 3. 사이트 보안 접속 비밀번호 (필수/기본값: 0208)
# Google API 키 남용 방지를 위한 접속 잠금 해제 PIN 번호입니다.
APP_PASSWORD=0208

# 4. Flask 세션 암호화 비밀키 (선택사항)
# 세션 쿠키 서명에 사용되는 임의의 보안 문자열입니다.
SECRET_KEY=data-insight-builder-secure-pin-0208

# 5. 최대 업로드 파일 크기 (단위: MB, 기본값: 10)
MAX_UPLOAD_MB=10

# 6. Flask 디버그 모드 (로컬 개발용: false 권장)
FLASK_DEBUG=false
